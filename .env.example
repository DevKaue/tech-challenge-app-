# Copie para .env antes de subir o projeto:
#   cp .env.example .env
#
# O docker-compose.yml lê DAQUI por interpolação (${VAR}). Se o .env não
# existir, o Compose aborta com a mensagem "copie .env.example para .env" —
# em vez de subir com valores vazios e falhar de forma confusa.
#
# Este arquivo também é lido por `npm run start:dev`, que roda a API fora do
# container (via dotenv em src/main.ts). Nesse caso o host do banco é
# localhost:5433 — a porta que o compose publica. Veja a nota no DATABASE_URL.

# ─── Banco (serviço `db` do compose) ─────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminpassword
POSTGRES_DB=oficinadb

# ─── Aplicação ───────────────────────────────────────────────────────
# Host `db` = nome do serviço no compose. Para rodar FORA do container
# (`npm run start:dev`), troque `db:5432` por `localhost:5433`.
DATABASE_URL=postgresql://admin:adminpassword@db:5432/oficinadb?schema=public

# Banco separado para a suíte de integração, criado por scripts/init-test-db.sql.
DATABASE_URL_TEST=postgresql://admin:adminpassword@db:5432/oficinadb_test?schema=public

# Obrigatórias: validateEnv() derruba a aplicação no boot sem qualquer uma das
# quatro (DATABASE_URL, JWT_SECRET, PASSWORD_SALT, WEBHOOK_SECRET).
#
# Os valores abaixo são de DESENVOLVIMENTO e funcionam sem edição — a promessa
# do QUICKSTART é `cp .env.example .env && docker compose up`. Eles já estiveram
# públicos no histórico deste repositório: NUNCA os reutilize fora do local.
# Em produção nada disso é usado — o Terraform gera segredos aleatórios.
JWT_SECRET=techchallenge_secret_key_2026

# ATENÇÃO: salt fixo e global do ScryptPasswordHasher. Trocar invalida TODAS as
# senhas já gravadas no banco — o login passa a devolver 401 com a senha certa.
# Este valor específico é o que gerou os hashes do seed; se você trocá-lo,
# rode `docker compose down -v` para recriar o banco do zero.
PASSWORD_SALT=4a7b1e8f9c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f

# Segredo do webhook de aprovação externa de orçamento.
# Assina o corpo em HMAC-SHA256 (header `x-webhook-signature: sha256=<hex>`).
WEBHOOK_SECRET=techchallenge_webhook_secret_2026

PORT=3000

# ─── SonarQube (perfil opcional do compose) ──────────────────────────
SONAR_ADMIN_PASSWORD=SonarAdmin123!
# Token gerado na UI do SonarQube. Sem ele, `docker compose run sonar-scanner`
# aborta com mensagem explícita.
SONAR_TOKEN=
