# Copie para .env.secret (gitignored) e ajuste. O Kustomize gera o Secret a
# partir deste arquivo e sufixa o nome com um hash do conteúdo — editar aqui
# dispara rolling restart automaticamente.
POSTGRES_USER=techchallenge
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=oficinadb
DATABASE_URL=postgresql://techchallenge:troque_esta_senha@postgres.techchallenge.svc.cluster.local:5432/oficinadb?schema=public
JWT_SECRET=troque_este_segredo
# ATENÇÃO: trocar o PASSWORD_SALT invalida TODAS as senhas já gravadas.
PASSWORD_SALT=troque_este_salt

# Segredo compartilhado do webhook de aprovação externa de orçamento.
# HMAC-SHA256 do corpo, header `x-webhook-signature: sha256=<hex>`.
WEBHOOK_SECRET=troque_este_segredo
