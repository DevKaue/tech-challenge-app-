generator client {
  provider = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum ServiceOrderStatus {
  RECEIVED
  IN_DIAGNOSIS
  WAITING_APPROVAL
  IN_EXECUTION
  FINISHED
  DELIVERED
  CLOSED
}

enum UserRole {
  MECHANIC
  ATTENDANT
}

enum EstimateStatus {
  PENDING
  APPROVED
  REJECTED
  NEGOTIATED
}

enum ServiceOrderItemType {
  SERVICE
  PART
}

enum MaterialType {
  PART
  SUPPLY
}

enum StockUnit {
  UNIT
  LITER
  MILLILITER
  GRAM
  KILOGRAM
  METER
}

enum DocumentType {
  CPF
  CNPJ
  PASSPORT
  RNE
}

model Customer {
  id            String         @id @default(uuid()) @map("id")
  document      String         @map("document")
  documentType  DocumentType   @map("document_type")
  name          String         @map("name")
  email         String?
  phone         String?
  vehicles      Vehicle[]
  serviceOrders ServiceOrder[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")

  @@unique([document, documentType], name: "uq_customer_document")
  @@map("customers")
}

model Vehicle {
  id            String         @id @default(uuid()) @map("id")
  plate         String         @map("plate") // O @unique foi removido daqui
  brand         String         @map("brand")
  model         String         @map("model")
  year          Int            @map("year")
  customerId    String         @map("customer_id")
  customer      Customer       @relation(fields: [customerId], references: [id])
  serviceOrders ServiceOrder[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")

  @@unique([plate], map: "vehicles_plate_active_unique_idx", where: { deletedAt: null })
  @@map("vehicles")
}

model ServiceCatalog {
  id          String   @id @default(uuid()) @map("id")
  name        String   @map("name")
  description String?
  price       Float    @map("price")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("service_catalog")
}

model Material {
  id            String       @id @default(uuid()) @map("id")
  name          String       @map("name")
  description   String?
  price         Float        @map("price")
  type          MaterialType @default(PART) @map("type")
  stockQuantity Float        @default(0) @map("stock_quantity")
  stockUnit     StockUnit    @default(UNIT) @map("stock_unit")
  expiresAt     DateTime?    @map("expires_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("parts")
}

model User {
  id            String         @id @default(uuid()) @map("id")
  name          String         @map("name")
  role          UserRole       @map("role")
  email         String         @unique
  passwordHash  String         @map("password_hash")
  phone         String?
  available     Boolean        @default(true) @map("available")
  serviceOrders ServiceOrder[] @relation("AssignedMechanic")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("users")
}

model ServiceOrder {
  id         String             @id @default(uuid()) @map("id")
  customerId String             @map("customer_id")
  customer   Customer           @relation(fields: [customerId], references: [id])
  vehicleId  String             @map("vehicle_id")
  vehicle    Vehicle            @relation(fields: [vehicleId], references: [id])
  status     ServiceOrderStatus @default(RECEIVED) @map("status")
  mileage    Int?
  notes      String?
  mechanicId String?            @map("mechanic_id")
  mechanic   User?              @relation("AssignedMechanic", fields: [mechanicId], references: [id])
  closedAt   DateTime?          @map("closed_at")

  statusHistory ServiceOrderStatusHistory[]
  estimates     Estimate[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([customerId], name: "idx_service_orders_customer_id")
  @@index([vehicleId], name: "idx_service_orders_vehicle_id")
  @@index([status], name: "idx_service_orders_status")
  @@index([createdAt], name: "idx_service_orders_created_at")
  @@map("service_orders")
}

model ServiceOrderStatusHistory {
  id             String              @id @default(uuid()) @map("id")
  serviceOrderId String              @map("service_order_id")
  serviceOrder   ServiceOrder        @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  previousStatus ServiceOrderStatus? @map("previous_status")
  newStatus      ServiceOrderStatus  @map("new_status")
  changedBy      String?             @map("changed_by") @db.VarChar(150)
  notes          String?
  changedAt      DateTime            @default(now()) @map("changed_at")

  @@index([serviceOrderId], name: "idx_status_history_service_order_id")
  @@index([changedAt], name: "idx_status_history_changed_at")
  @@map("service_order_status_history")
}

model Estimate {
  id             String         @id @default(uuid()) @map("id")
  serviceOrderId String         @map("service_order_id")
  serviceOrder   ServiceOrder   @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  status         EstimateStatus @default(PENDING) @map("status")
  totalAmount    Decimal        @default(0) @map("total_amount") @db.Decimal(10, 2)
  validUntil     DateTime?      @map("valid_until")
  approvedAt     DateTime?      @map("approved_at")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  items EstimateItem[]

  @@index([serviceOrderId], name: "idx_estimates_service_order_id")
  @@index([status], name: "idx_estimates_status")
  @@map("estimates")
}

model EstimateItem {
  id          String               @id @default(uuid()) @map("id")
  estimateId  String               @map("estimate_id")
  estimate    Estimate             @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  itemType    ServiceOrderItemType @map("item_type")
  referenceId String               @map("reference_id")
  description String               @map("description") @db.VarChar(200)
  quantity    Decimal              @map("quantity") @db.Decimal(10, 3)
  unitPrice   Decimal              @map("unit_price") @db.Decimal(10, 2)
  totalPrice  Decimal              @map("total_price") @db.Decimal(10, 2)
  notes       String?

  @@unique([estimateId, itemType, referenceId], name: "uq_estimate_item")
  @@index([estimateId], name: "idx_estimate_items_estimate_id")
  @@index([referenceId], name: "idx_estimate_items_reference_id")
  @@index([itemType], name: "idx_estimate_items_item_type")
  @@map("estimate_items")
}
